{
  "manifest_version": 3,
  "name": "prompt-plus-plus-chrome-extension",
  "version": "0.1.0",
  "description": "Interprets and replaces text using prompt++",
  "permissions": [
    "contextMenus",
    "scripting",
    "activeTab"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "icons": {
    "16": "resources/prompt++16.png",
    "48": "resources/prompt++48.png",
    "128": "resources/prompt++128.png"
  },
  "action": {
    "default_icon": {
      "16": "resources/prompt++16.png",
      "48": "resources/prompt++48.png"
    }
  },
  "background": {
    "service_worker": "dist/background.js"
  },
  "options_page": "options.html"
}
