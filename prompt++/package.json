{
  "name": "prompt-plus-plus",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "prompt++": "dist/prompt++.js"
  },
  "exports": {
